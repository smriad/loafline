# Copy to .env.local for local dev. Set the same vars on Render.

DEMO_MODE=false

# Gemma (open-weight) — OpenAI-compatible router
OLLAMA_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=google/gemma-3-4b-it

# Tinker — OpenAI-compatible inference
TINKER_API_KEY=
TINKER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
TINKER_MODEL=thinkingmachines/Inkling

# TabPFN (Prior Labs) — optional cached fit from dashboard
PRIORLABS_API_KEY=
TABPFN_FITTED_TRAIN_SET_ID=

MONGODB_URI=
MONGODB_DB=loafline
TIGER_DATABASE_URL=
# Set true only if you need strict TLS verification (Tiger Cloud usually needs false locally)
TIGER_SSL_REJECT_UNAUTHORIZED=false

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

SENTRY_DSN=
SERPAPI_API_KEY=

BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

RENDER_EXTERNAL_URL=
